<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Scramblegrams</title>
  <meta name="description" content="Build words, score points">
  <meta name="theme-color" content="#121213">
  <link rel="manifest" href="/manifest.json">
  <link rel="apple-touch-icon" href="/icon.svg">
  <link rel="stylesheet" href="style.css">
</head>
<body>

<div id="app">

  <!-- ── Start ─────────────────────────────────────────────────────────────── -->
  <div id="start-screen">
    <div class="start-top">
      <h1 class="start-title">SCRAMBLEGRAMS</h1>
    </div>
    <p class="start-sub">Build words, score points</p>

    <fieldset class="mode-group">
      <legend>Game mode</legend>
      <label class="mode-card">
        <input type="radio" name="mode" value="classical" checked>
        <span class="mode-card-name">Classical</span>
        <span class="mode-card-desc">Count-up · Play until done</span>
      </label>
      <label class="mode-card">
        <input type="radio" name="mode" value="bullet">
        <span class="mode-card-name">Bullet</span>
        <span class="mode-card-desc">1 minute</span>
      </label>
      <label class="mode-card">
        <input type="radio" name="mode" value="blitz">
        <span class="mode-card-name">Blitz</span>
        <span class="mode-card-desc">3 minutes</span>
      </label>
      <label class="mode-card">
        <input type="radio" name="mode" value="rapid">
        <span class="mode-card-name">Rapid</span>
        <span class="mode-card-desc">10 minutes</span>
      </label>
    </fieldset>

    <button id="start-btn" class="btn-primary">Start Game</button>
    <button id="lb-icon-btn" aria-label="Leaderboard">
      <svg width="22" height="18" viewBox="0 0 22 18" fill="currentColor">
        <rect x="0" y="6"  width="6" height="12" rx="1.5"/>
        <rect x="8" y="0"  width="6" height="18" rx="1.5"/>
        <rect x="16" y="9" width="6" height="9"  rx="1.5"/>
      </svg>
    </button>
  </div>

  <!-- ── Profile setup ──────────────────────────────────────────────────────── -->
  <div id="profile-screen" hidden>
    <button class="screen-back" id="profile-back">←</button>
    <h2 class="screen-title">Create your profile</h2>
    <p class="screen-sub">Your name and flag will appear on the leaderboard</p>

    <div class="profile-field">
      <label class="field-label" for="profile-name">Nickname</label>
      <input id="profile-name" class="field-input" type="text"
        placeholder="e.g. WordWizard"
        maxlength="20" autocomplete="off" autocorrect="off" spellcheck="false">
    </div>

    <div class="profile-field flag-field">
      <p class="field-label">Country</p>
      <div class="flag-grid-scroll">
        <div id="flag-grid" class="flag-grid"></div>
      </div>
    </div>

    <button id="profile-save" class="btn-primary" disabled>Save &amp; continue</button>
  </div>

  <!-- ── Leaderboard ────────────────────────────────────────────────────────── -->
  <div id="leaderboard-screen" hidden>
    <div class="lb-header">
      <button class="screen-back" id="lb-back">←</button>
      <h2 class="screen-title">Leaderboard</h2>
    </div>

    <div class="lb-tabs">
      <button class="lb-tab active" data-mode="classical">Classical</button>
      <button class="lb-tab" data-mode="bullet">Bullet</button>
      <button class="lb-tab" data-mode="blitz">Blitz</button>
      <button class="lb-tab" data-mode="rapid">Rapid</button>
    </div>

    <div id="lb-list" class="lb-list"></div>
  </div>

  <!-- ── Game ──────────────────────────────────────────────────────────────── -->
  <div id="game-screen" hidden>
    <bg-game-header id="header"></bg-game-header>

    <div id="game-body">
      <bg-word-board id="word-board"></bg-word-board>
    </div>

    <div id="bottom-panel">
      <bg-tile-rack id="tile-rack"></bg-tile-rack>
      <sg-tray id="tray"></sg-tray>
      <div id="bottom-actions">
        <button id="draw-btn">Draw</button>
        <button id="done-btn">Finish</button>
      </div>
      <p id="status-msg" class="status-msg"></p>
    </div>
  </div>

  <!-- ── Result ─────────────────────────────────────────────────────────────── -->
  <div id="result-screen" hidden>
    <h2>Game over</h2>
    <div id="final-score"></div>
    <p id="final-time"></p>
    <p id="final-rank" class="final-rank"></p>
    <div id="final-words"></div>
    <button id="lb-result-btn" class="btn-secondary">View leaderboard</button>
    <button id="share-btn" class="btn-secondary">Share score</button>
    <button id="play-again-btn" class="btn-primary">Play again</button>
  </div>

</div>

<script>
  if ('serviceWorker' in navigator) navigator.serviceWorker.register('/sw.js');
</script>
<script type="module" src="js/app.js"></script>

</body>
</html>
